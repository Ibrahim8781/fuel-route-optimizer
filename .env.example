# Copy to .env and fill in. Never commit .env.

# Required: free key from https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# Development settings
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional overrides (defaults shown)
# ORS_PROFILE=driving-hgv
# FUEL_MAX_RANGE_MILES=500
# FUEL_MPG=10
# FUEL_CORRIDOR_MILES=5
# FUEL_START_WINDOW_MILES=25
# ROUTE_CACHE_SECONDS=86400
# API_RATE_LIMIT=60/minute
# REDIS_URL=redis://localhost:6379/0   # shared cache for multiple workers (pip install redis)

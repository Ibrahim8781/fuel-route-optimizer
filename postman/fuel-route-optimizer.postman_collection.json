                  "pm.test(\"stop costs add up to the total\", () => pm.expect(body.fuel_stops.reduce((t, s) => t + s.cost_usd, 0)).to.be.closeTo(body.summary.total_fuel_cost_usd, 0.05));",
                  "pm.test(\"no single leg is longer than 500 miles\", () => {",
                  "  const marks = [0, ...body.fuel_stops.map(s => s.mile_marker), body.summary.distance_miles];",
                  "  for (let i = 1; i < marks.length; i++) pm.expect(marks[i] - marks[i - 1]).to.be.at.most(500.5);",
                  "});",
